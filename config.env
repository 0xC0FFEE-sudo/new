# ~/.local/share/newvm/config.env - shipped defaults for `new`.
# Your own overrides live in ~/.config/newvm/config.env (copy this file there
# and edit it). Environment variables beat both: NEW_MEM=4096 new

# resources handed to every sandbox
NEW_MEM=8192                 # MB of RAM
NEW_CPUS=                    # cores; empty means min(8, host logical cores)
NEW_DISK=102400              # MB of disk (100 GB)

# what happens when the session ends
NEW_SAVE=auto                # auto | always | never
                             # auto = save, unless the folder has nothing saved yet
NEW_MOUNT=ro                 # ro  = overlay (RAM), guest writes never touch the host
                             # rw  = guest writes land directly in the host folder
                             # none= no host directory at all

# the image
NEW_BASE=newvm-base          # golden toolchain checkpoint name
NEW_PROFILE=full             # core | full
NEW_EXTRAS=                  # comma list baked into the image, e.g. k8s,java,ruby

# network and credentials
NEW_NET=on                   # on | off
NEW_HOSTS=                   # comma list of allowed domains (empty = all)
NEW_PORTS=                   # comma list of host:guest ports, e.g. 3000,8080:80
NEW_SECRETS=on               # wire host API keys into the sandbox

# host credentials copied into the image (so codex/claude stay logged in)
NEW_SYNC_AUTH=1
NEW_SYNC_GITCONFIG=1
NEW_SYNC_SSH=0               # 1 also copies ~/.ssh/id_* into the image

# shell to start inside the sandbox
NEW_SHELL=bash               # bash | zsh | fish